{
  "name": "@certible/use-matomo",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "version": "1.2.1",
  "packageManager": "pnpm@12.15.0",
  "description": "A typed framework agnostic wrapper for Matomo js including SPA tracking.",
  "author": "Certible <oberreiter@certible.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/certible/use-matomo.git"
  },
  "bugs": {
    "url": "https://github.com/certible/use-matomo/issues"
  },
  "homepage": "https://github.com/certible/use-matomo#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ci": "pnpm run build && vitest"
  },
  "keywords": [
    "matomo",
    "spa",
    "analytics",
    "tracking"
  ],
  "devDependencies": {
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
